// Modelo compartilhado: contexto, contêineres e componentes são projeções deste grafo.
// Etapa 3: cinco componentes dentro da API; relações profundas se agregam nos níveis anteriores.
model {
  operador = actor 'Operador de estoque' {
    description 'Cadastra produtos, registra movimentações e consulta saldos.'
  }

  gestor = actor 'Gestor de estoque' {
    description 'Consulta estoque crítico e configura limites mínimos.'
  }

  estoque = system 'Sistema de Gestão de Estoque' {
    description 'Mantém produtos, saldos e movimentações; solicita alertas ao cruzar o estoque mínimo.'

    web = application 'Aplicação Web' {
      description 'Interface para operações manuais, consultas e gestão dos limites.'
      technology 'SPA (framework não definido)'
    }

    api = application 'API de Estoque' {
      description 'Expõe operações, regras de negócio e consistência transacional.'
      technology 'ASP.NET Core / C# (.NET 10)'

      // Os cinco componentes pertencem apenas à API, não são contêineres.
      http = component 'Endpoints HTTP' {
        description 'Recebe requisições, valida contratos de entrada e encaminha casos de uso.'
        technology 'ASP.NET Core'
      }

      movimentacoes = component 'Movimentações de Estoque' {
        description 'Orquestra RegistrarEntrada, RegistrarSaida e idempotência da operação.'
        technology 'Aplicação / Casos de Uso'
      }

      gestao = component 'Gestão e Consultas' {
        description 'Cadastra produtos, consulta saldos e ajusta estoques mínimos.'
        technology 'Aplicação / Casos de Uso'
      }

      regras = component 'Regras de Estoque' {
        description 'Aplica invariantes de quantidade, saldo e cruzamento do estoque mínimo.'
        technology 'Domínio'
      }

      persistencia = component 'Persistência Transacional' {
        description 'Garante atomicidade, concorrência, unicidade de origem e gravação da outbox.'
        technology 'Infraestrutura / PostgreSQL'
      }
    }

    worker = application 'Worker de Notificações' {
      description 'Consome a outbox e solicita alertas de maneira assíncrona.'
      technology '.NET Worker Service / C#'
    }

    banco = database 'Banco de Dados' {
      description 'Produtos, saldos, histórico, referência externa e outbox.'
      technology 'PostgreSQL'
    }
  }

  vendas = externalSystem 'Sistema de Vendas' {
    description 'Solicita baixa de unidades após uma venda, com referência idempotente.'
  }

  notificacoes = externalSystem 'Provedor de Notificações' {
    description 'Recebe solicitações de envio de alerta feitas pelo worker.'
  }

  operador -> estoque.web 'Cadastra, movimenta e consulta' {
    technology 'HTTPS'
  }
  gestor -> estoque.web 'Consulta críticos e ajusta mínimos' {
    technology 'HTTPS'
  }
  // No nível 2, LikeC4 projeta Web/Vendas -> API e API -> PostgreSQL.
  // As relações autoritativas chegam aos componentes da API; não há
  // relações redundantes com o contêiner pai.
  estoque.web -> estoque.api.http 'Solicita operações e consultas' {
    technology 'JSON/HTTPS'
  }
  vendas -> estoque.api.http 'Solicita baixa de estoque por venda' {
    technology 'JSON/HTTPS'
  }

  estoque.api.http -> estoque.api.movimentacoes 'Encaminha entradas e saídas'
  estoque.api.http -> estoque.api.gestao 'Encaminha cadastro e consultas'
  estoque.api.movimentacoes -> estoque.api.regras 'Aplica invariantes de saldo'
  estoque.api.gestao -> estoque.api.regras 'Aplica regras de produto e limite'
  estoque.api.movimentacoes -> estoque.api.persistencia 'Confirma movimentação e outbox'
  estoque.api.gestao -> estoque.api.persistencia 'Consulta e persiste produtos'

  estoque.api.persistencia -> estoque.banco 'Lê e grava dados transacionais' {
    technology 'PostgreSQL/TCP'
  }
  estoque.worker -> estoque.banco 'Consulta e atualiza a outbox' {
    technology 'PostgreSQL/TCP'
  }
  estoque.worker -> notificacoes 'Solicita envio de alertas' {
    // O contrato concreto com o provedor externo ainda não foi definido.
    technology 'API externa (contrato a definir)'
  }
}
